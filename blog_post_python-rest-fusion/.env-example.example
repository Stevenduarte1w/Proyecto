# App / database
DEBUG=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_post_bot
DB_USER=blog_post_bot
DB_PASSWORD=replace-me

# AI generation. Leave OPENAI_API_KEY empty only if jobs always receive complete text
# and image URLs from the orchestrator.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-4
OPENAI_META_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_OUTPUT_DIR=app/static/images

# Local scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Bogota
SCHEDULER_BATCH_SIZE=20
LOCAL_MAX_CONCURRENCY=3

# Isolated post-bot worker channel. Use the same token registered in the
# orchestrator's BOT_TOKENS map. The REST token authenticates the worker's local
# callback into this app; do not reuse it as POST_BOT_WS_TOKEN.
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_TOKEN=
POST_BOT_WS_URL=ws://localhost:8005/api/v1/post-bot/ws
POST_BOT_WS_TOKEN=
POST_BOT_BOT_KEY=post-bot-prod-01
POST_BOT_NAME=AI WordPress Post Bot
POST_BOT_CALLBACK_URL=http://127.0.0.1:8000/api/orchestrator/jobs
ORCHESTRATOR_MAX_CONCURRENCY=2

# WordPress REST Application Passwords. Each site's credential_ref in the database
# names the environment variable to read. Migrations initially create WP_SITE_<id>_APP_PASSWORD.
WP_SITE_1_APP_PASSWORD=replace-with-a-new-wordpress-application-password
WORDPRESS_HTTP_TIMEOUT=45
WORDPRESS_MAX_READ_RETRIES=3
