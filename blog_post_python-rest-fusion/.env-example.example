# App / database
DEBUG=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_post_bot
DB_USER=blog_post_bot
DB_PASSWORD=replace-me

# AI generation. Leave OPENAI_API_KEY empty only if jobs always receive complete text
# and image URLs from the orchestrator.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-4
OPENAI_META_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_OUTPUT_DIR=app/static/images

# Local scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Bogota

# Orchestrator REST ingress; keep disabled until the orchestrator is configured
# to POST signed jobs to /api/orchestrator/jobs.
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_TOKEN=

# WordPress REST Application Passwords. Each site's credential_ref in the database
# names the environment variable to read. Migrations initially create WP_SITE_<id>_APP_PASSWORD.
WP_SITE_1_APP_PASSWORD=replace-with-a-new-wordpress-application-password
WORDPRESS_HTTP_TIMEOUT=45
WORDPRESS_MAX_READ_RETRIES=3
