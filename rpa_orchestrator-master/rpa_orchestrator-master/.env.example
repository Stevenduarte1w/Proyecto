APP_NAME=RPA Orchestrator
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_DSN=postgresql+asyncpg://orchestrator:orchestrator@postgres:5432/orchestrator
SEO_AGENT_DSN=postgresql+asyncpg://seo_manager:databasepassword1@host.docker.internal:5432/seo_agent_deep_seek
MONGO_DSN=mongodb://orchestrator:change-me@mongo:27017/seo_flows?authSource=admin
MONGO_DATABASE=seo_flows
MONGO_USERNAME=orchestrator
MONGO_PASSWORD=change-me
REDIS_PASSWORD=change-me
REDIS_DSN=redis://:change-me@redis:6379/0

BOT_REQUEST_TIMEOUT_SECONDS=30
BOT_MAX_RETRIES=3
EXECUTION_LOCK_TTL_SECONDS=900
BOT_PRESENCE_TTL_SECONDS=60
BOT_HEARTBEAT_GRACE_SECONDS=60
BOT_RECONCILIATION_INTERVAL_SECONDS=15
PAGE_EXECUTION_LOG_TTL_SECONDS=86400
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me
# JSON: token del worker -> bot_key. Requerido para bots ajenos al flujo de páginas.
# No reutilizar el token del cliente REST.
BOT_TOKENS={"replace-with-saaf-secret":"saaf-backlinks-01","replace-with-post-bot-secret":"post-bot-prod-01","replace-with-instagram-secret":"instagram-backend-01"}
POST_MONITOR_WS_TOKEN=
POST_MONITOR_PRESENCE_TTL_SECONDS=60
POST_MONITOR_MAX_MESSAGE_BYTES=262144

# Canal aislado del bot de posts (/api/v1/post-bot/ws).
# Su credencial va en BOT_TOKENS, con su propia entrada token -> bot_key.
POST_BOT_PRESENCE_TTL_SECONDS=60
POST_BOT_MAX_MESSAGE_BYTES=262144

# Backend Django usado como catalogo de Instagram.
# INSTAGRAM_BACKEND_TOKEN no es el token de worker: autentica las llamadas
# que hace el orquestador hacia Django. Ver docs/instagram-auth-setup.md.
INSTAGRAM_BACKEND_URL=
INSTAGRAM_BACKEND_TOKEN=

RANK_PROVIDER=serper
SERPER_API_KEY=
SERPER_API_BASE_URL=https://google.serper.dev
SERPER_RANK_NUM_RESULTS=100
SERPER_REQUEST_TIMEOUT_SECONDS=15

BRIGHTLOCAL_API_KEY=
BRIGHTLOCAL_API_BASE_URL=https://api.brightlocal.com
BRIGHTLOCAL_RANK_NUM_RESULTS=100
BRIGHTLOCAL_RANK_TIMEOUT_SECONDS=45
BRIGHTLOCAL_RANK_POLL_INTERVAL_SECONDS=1.5
